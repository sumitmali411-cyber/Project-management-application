{
  "realm": "devsync",
  "enabled": true,
  "displayName": "DevSync",
  "displayNameHtml": "<strong>DevSync</strong>",

  "loginTheme":   "devsync",
  "accountTheme": "keycloak",
  "adminTheme":   "keycloak",
  "emailTheme":   "keycloak",

  "sslRequired": "none",

  "registrationAllowed":          true,
  "registrationEmailAsUsername":  false,
  "rememberMe":                   true,
  "verifyEmail":                  false,
  "loginWithEmailAllowed":        true,
  "duplicateEmailsAllowed":       false,
  "resetPasswordAllowed":         true,
  "editUsernameAllowed":          false,

  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,

  "accessTokenLifespan":              900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout":            1800,
  "ssoSessionMaxLifespan":            36000,
  "offlineSessionIdleTimeout":        2592000,
  "refreshTokenMaxReuse":             0,

  "clients": [
    {
      "clientId": "devsync-app",
      "name": "DevSync Angular App",
      "description": "Public PKCE client for the DevSync frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,

      "redirectUris": [
        "http://localhost:4300/*",
        "http://localhost:4301/*",
        "http://localhost:4302/*"
      ],
      "webOrigins": [
        "http://localhost:4300",
        "http://localhost:4301",
        "http://localhost:4302"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "devsync-backend",
      "name": "DevSync Spring Boot Backend",
      "description": "Confidential client for backend JWT validation",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "bearerOnly": true
    }
  ],

  "roles": {
    "realm": [
      { "name": "ADMIN",  "description": "Full access — manage everything" },
      { "name": "PM",     "description": "Project Manager — manage projects and members" },
      { "name": "DEV",    "description": "Developer — create and update tasks" },
      { "name": "VIEWER", "description": "Read-only access" }
    ]
  },

  "defaultRoles": ["DEV"],

  "users": [
    {
      "username": "admin",
      "email": "admin@devapp.com",
      "firstName": "Admin",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    }
  ],

  "smtpServer": {},

  "internationalizationEnabled": false,
  "supportedLocales": ["en"],
  "defaultLocale": "en",

  "eventsEnabled": true,
  "eventsListeners": ["jboss-logging"],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,

  "passwordPolicy": "length(8) and upperCase(1) and digits(1)"
}
